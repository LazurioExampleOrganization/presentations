{
	"name": "presentations-app-v1",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "bun --no-env-file run src/server.ts",
		"build": "tsc -b && bun run prepare:app",
		"typecheck": "tsc -b --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "bun run typecheck && bun run lint",
		"check:prepared": "bun run src/prepared.ts",
		"test": "bun test tests",
		"prepare:app": "bun run src/check-previews.ts && bun ./node_modules/vite/bin/vite.js build"
	},
	"dependencies": {
		"@lazurio/module-kit": "github:Lazurio/module-kit#v0.2.0",
		"@vitejs/plugin-react": "6.0.5",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"vite": "8.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/bun": "1.4.2",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"typescript": "5.9.3"
	},
	"lazurio": {
		"runtime": {
			"schema_version": "lazurio.runtime.v1",
			"id": "exampleorganization-presentations-v1",
			"title": "Presentations",
			"company": "ExampleOrganization",
			"module": "presentations",
			"surface": "internal",
			"dev_script": "dev",
			"build_script": "build",
			"tags": [
				"presentations"
			],
			"listeners": [
				{
					"id": "web",
					"role": "entrypoint",
					"lease": "main",
					"protocol": "http",
					"health": {
						"kind": "http",
						"path": "/"
					}
				}
			],
			"description": "Knihovna prezentac\u00ed a tvorba s Agentem."
		},
		"preparation": {
			"schema_version": "lazurio.preparation.v1",
			"owner_package": "app/v1/package.json",
			"check_script": "check:prepared",
			"prepare_script": "prepare:app"
		}
	}
}
