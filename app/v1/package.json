{
  "name": "presentations-app-v1",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --no-env-file run src/server.ts",
    "build": "tsc -b && bun run prepare:app",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run typecheck && bun run lint && bun run prepare:app && bun test tests",
    "check:prepared": "bun run src/prepared.ts",
    "test": "bun test tests",
    "prepare:app": "bun run src/check-previews.ts && bun ./node_modules/vite/bin/vite.js build"
  },
  "dependencies": {
    "@lazurio/module-kit": "github:Lazurio/module-kit#v0.2.0",
    "@vitejs/plugin-react": "6.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "lazurioexampleorganization-presentations-v1",
      "title": "Presentations",
      "company": "LazurioExampleOrganization",
      "module": "presentations",
      "surface": "internal",
      "dev_script": "dev",
      "build_script": "build",
      "tags": [
        "presentations"
      ],
      "listeners": [
        {
          "id": "web",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/"
          }
        }
      ],
      "description": "Knihovna prezentací a tvorba s Agentem."
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "app/v1/package.json",
      "check_script": "check:prepared",
      "prepare_script": "prepare:app"
    }
  }
}
